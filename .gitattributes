# Alles mit Unix-Zeilenenden auschecken, unabhaengig von core.autocrlf.
#
# Grund: install.sh scheitert mit Windows-Zeilenenden sofort
# ("set -o pipefail\r: Ungueltiger Optionsname"), und dasselbe gilt fuer
# jedes andere Skript, das mal dazukommt. Lieber einmal pauschal
# festlegen als es pro Dateityp zu jagen.
* text=auto eol=lf

# Ausnahmen: Binaerdateien nicht anfassen.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.webm binary
*.ogg  binary
*.woff  binary
*.woff2 binary
*.zip  binary
*.gz   binary
