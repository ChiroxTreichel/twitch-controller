# =====================================================================
#  Overlays - Bootstrap-Konfiguration
#
#  Kopieren:  cp .env.example .env
#
#  Hier steht nur, was gebraucht wird, BEVOR die Datenbank da ist.
#  Alles andere - Twitch-Zugangsdaten, Kanal, Plugin-Einstellungen -
#  wird beim ersten Aufruf im Browser eingerichtet und liegt in der
#  Datenbank.
# =====================================================================


# ---------------------------------------------------------------------
#  Domain
# ---------------------------------------------------------------------
# Die Domain, unter der alles laeuft. Der DNS-A-Record muss auf diesen
# Server zeigen.
APP_DOMAIN=overlays.example.com

# Vollstaendige Basis-URL, ohne Slash am Ende. Twitch verlangt fuer
# OAuth und EventSub HTTPS.
APP_URL=https://overlays.example.com


# ---------------------------------------------------------------------
#  Schluessel
# ---------------------------------------------------------------------
# Verschluesselt die Geheimnisse in der Datenbank (Twitch-Secret,
# Tokens) und signiert die Login-Rueckwege.
#
#   openssl rand -hex 32
#
# Achtung: wird der Schluessel geaendert, sind alle gespeicherten
# Geheimnisse unlesbar und muessen neu eingegeben werden.
APP_KEY=


# ---------------------------------------------------------------------
#  Datenbank
# ---------------------------------------------------------------------
# Laeuft als eigener Container und ist von aussen nicht erreichbar.
# DB_HOST bleibt "db" (= Servicename im Compose).
DB_HOST=db
DB_PORT=5432
DB_NAME=overlays
DB_USER=overlays
#   openssl rand -hex 24
DB_PASS=


# ---------------------------------------------------------------------
#  Reverse Proxy
# ---------------------------------------------------------------------
# Standard: der mitgelieferte Caddy holt sich selbst ein Zertifikat.
# Dafuer muessen Port 80 und 443 auf dem Host frei sein.
COMPOSE_PROFILES=caddy
ACME_EMAIL=

# Eigener Proxy (z.B. Nginx Proxy Manager) statt Caddy? Dann Caddy
# abschalten und das Override dazunehmen:
#
#   COMPOSE_PROFILES=
#   COMPOSE_FILE=docker-compose.yaml:docker-compose.npm.yaml
#
# und einmalig:  docker network create proxy
# Der Proxy zeigt dann auf Host "overlays", Port 80.

# Host-Bindung des Webcontainers. 127.0.0.1 = nur lokal erreichbar,
# richtig wenn ein Proxy davor haengt. Fuer einen Proxy auf einem
# ANDEREN Rechner: 0.0.0.0:2300 - dann aber die Firewall pruefen.
WEB_BIND=127.0.0.1:2300


# ---------------------------------------------------------------------
#  Sprache
# ---------------------------------------------------------------------
# Nur der Startwert - aenderbar ist die Sprache spaeter unter
# Konto > Einstellungen. Vorhanden ist, wofuer eine Datei
# lang/<code>.json existiert.
APP_LANG=de


# ---------------------------------------------------------------------
#  Hintergrundprozess
# ---------------------------------------------------------------------
# Sekunden zwischen zwei Durchlaeufen des Hooks "cron.tick", an dem
# Plugins ihre wiederkehrenden Aufgaben haengen.
WORKER_INTERVAL=15
