# Geheimnisse
/.env

# Datenbank-Dateien
/pgdata/

# Vom Streamer hochgeladene Dateien (Alert-Videos, Sounds)
/public/uploads/*
!/public/uploads/.gitkeep

# Installierte Plugins. Die kommen aus dem Marktplatz oder werden von
# Hand hineingelegt - sie gehoeren dem Betreiber, nicht diesem
# Repository. Waeren sie verfolgt, wuerde jede Installation den
# Selbst-Update-Pull (git merge --ff-only) zum Konflikt bringen.
#
# Der Ordner wird von install.sh angelegt. Waehrend der Entwicklung
# liegt hier das Plugin-Repository twitch-controller-plugins - deshalb
# vollstaendig ignoriert und nicht nur der Inhalt: sonst meldet git den
# Ordner als unverfolgt und schaut in ein fremdes Repository hinein.
/plugins/

# Alter Code als Nachschlagewerk waehrend der Umstellung.
# Bewusst nicht im Repository: enthaelt Tokens, Team-Daten und die
# Konfiguration der bisherigen Installation.
/legacy/

# Logs
*.log

# Editor
/.idea/
/.vscode/
